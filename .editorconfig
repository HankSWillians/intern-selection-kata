# ============================================================
# .editorconfig — formato compartido entre editores
# https://editorconfig.org
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ---------- Java (backend) ----------
[*.java]
indent_size = 4
max_line_length = 120

# ---------- Markdown ----------
# Dos espacios al final de línea son un salto de línea en Markdown.
[*.md]
trim_trailing_whitespace = false

# ---------- Scripts de Windows ----------
[*.{bat,cmd,ps1}]
end_of_line = crlf

# ---------- Makefiles requieren tabuladores ----------
[Makefile]
indent_style = tab
