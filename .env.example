# Copiar a .env (en la raíz) y completar. .env está en .gitignore: nunca se sube.
# Lo lee el backend al arrancar (python-dotenv). Las rutas relativas se toman
# desde la carpeta backend/.

# ---------- Base de datos ----------
# Archivo SQLite. Se crea solo al arrancar y se aplican las migraciones.
DB_PATH=./var/data/intern-selection.db

# ---------- Archivos ----------
# Carpeta del servidor donde se guardan las hojas de vida (PDF).
UPLOAD_DIR=./var/uploads
# Tamaño máximo de la hoja de vida, en MB (RF-02).
MAX_CV_SIZE_MB=5

# ---------- Analista (RF-13) ----------
# Credenciales del único analista. La contraseña es obligatoria: sin ella el
# backend no arranca.
ANALYST_USERNAME=analista
ANALYST_PASSWORD=
# Clave para firmar los tokens de sesión, de al menos 32 caracteres.
# Se genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duración de la sesión, en horas.
JWT_TTL_HOURS=8

# ---------- Demostración (RF-19) ----------
# Con true, el backend carga 4 practicantes ficticios si la base está vacía.
DEMO_DATA=true
