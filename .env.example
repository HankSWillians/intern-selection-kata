# Copiar a .env (en la raíz) y completar. .env está en .gitignore: nunca se sube.
# Lo lee el backend. El frontend de Angular no lee este archivo: su URL de la
# API está en frontend/src/environments/environment.ts y en frontend/proxy.conf.json.

# ---------- Base de datos ----------
# Archivo SQLite. Se crea solo al arrancar y Flyway aplica las migraciones.
DB_PATH=./var/data/intern-selection.db

# ---------- Archivos ----------
# Carpeta del servidor donde se guardan las hojas de vida (PDF).
UPLOAD_DIR=./var/uploads
# Tamaño máximo de la hoja de vida, en MB (RF-04).
MAX_CV_SIZE_MB=5

# ---------- Analista (RF-13) ----------
# Credenciales del único analista. La contraseña es obligatoria: sin ella el
# backend no arranca.
ANALYST_USERNAME=analista
ANALYST_PASSWORD=
# Clave para firmar los tokens de sesión, de al menos 32 caracteres.
# Se genera con: openssl rand -base64 48
JWT_SECRET=

# ---------- Backend ----------
# Puerto del backend. Si se cambia, ajustar también frontend/proxy.conf.json.
SERVER_PORT=8080
# Solo hace falta si el frontend se sirve en otro dominio.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Nivel de log del código propio: TRACE, DEBUG, INFO, WARN o ERROR.
LOG_LEVEL=INFO
